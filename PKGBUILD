# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for labwc. Everything installed is generated by tools/build.py
# and committed, so building the package needs nothing but the repo.

pkgname=morvane-labwc-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for labwc: window theme and wallpaper'
arch=(any)
url='https://github.com/MorvaneOS/morvane-labwc-theme'
license=(LGPL-2.1-or-later)
depends=(
  morvane-gtk-theme   # the window theme (openbox-3), GTK apps, icons, cursor
  morvane-wm-theme    # alacritty and friends
  morvane-wallpapers
  swaybg
)
backup=(etc/xdg/labwc/rc.xml etc/xdg/labwc/autostart)

package() {
  # labwc reads ~/.config/labwc, then /etc/xdg/labwc
  install -Dm644 "$startdir"/labwc/rc.xml "$startdir"/labwc/autostart -t "$pkgdir/etc/xdg/labwc/"
}
